#########################################
# APP
#########################################

APP_NAME="Your Good Time API"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

#########################################
# DATABASE
#########################################

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

#########################################
# ASTROLOGY API
#########################################

ASTROLOGY_API_BASE_URL=https://json.astrologyapi.com/v1
ASTROLOGYAPI_ACCESS_TOKEN=

#########################################
# FRONTEND
#########################################

FRONTEND_URL=http://localhost:5173

#########################################
# MAIL
#########################################

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@yourgoodtime.in
MAIL_FROM_NAME="Your Good Time"
MAIL_SUPPORT_ADDRESS=support@yourgoodtime.in
MAIL_SUPPORT_NAME="Your Good Time Support"
ZEPTOMAIL_HOST=smtp.zeptomail.in
ZEPTOMAIL_PORT=587
ZEPTOMAIL_USERNAME=emailapikey
ZEPTOMAIL_PASSWORD=
ZEPTOMAIL_SCHEME=tls
ZEPTOMAIL_FROM_ADDRESS=support@yourgoodtime.in
ZEPTOMAIL_FROM_NAME="Your Good Time"
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_API_CONNECT_TIMEOUT=5
ZEPTOMAIL_API_TIMEOUT=10
MAIL_GATEWAY_URL=https://api.yourgoodtime.in/api/internal/mail/send-otp
MAIL_GATEWAY_SEND_URL=https://api.yourgoodtime.in/api/internal/mail/send
MAIL_GATEWAY_KEY=
MAIL_GATEWAY_TIMEOUT=10
# Non-OTP transactional gateway: local sendMail() only when APP_ENV=local
MAIL_GATEWAY_USE_LOCAL_MAILER=false
# OTP provider: local = default Laravel/GoDaddy mailer, zeptoapi = ZeptoMail HTTPS API
OTP_MAIL_SYSTEM=local
